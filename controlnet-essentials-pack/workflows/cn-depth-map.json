      "title": "Load Control Image"
    },
    "inputs": {
      "image": "control_input.png"
    }
  },
  "2": {
    "class_type": "CheckpointLoaderSimple",
    "_meta": {
      "title": "Checkpoint"
    },
    "inputs": {
      "ckpt_name": "sd_xl_base_1.0.safetensors"
    }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Positive"
    },
    "inputs": {
      "text": "interior design photography, architectural rendering, professional lighting, realistic materials, masterpiece, best quality, 8k uhd",
      "clip": [
        "2",
        1
      ]
    }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Negative"
    },
    "inputs": {
      "text": "low quality, blurry, distorted, deformed, ugly, disfigured, watermark, text, logo, worst quality, jpeg artifacts, cartoon, anime, oversaturated, noisy, extra limbs, bad anatomy, bad hands",
      "clip": [
        "2",
        1
      ]
    }
  },
  "5": {
    "class_type": "ControlNetLoader",
    "_meta": {
      "title": "ControlNet Model"
    },
    "inputs": {
      "control_net_name": "controlnet-depth-sdxl.safetensors"
    }
  },
  "6": {
    "class_type": "ControlNetApplyAdvanced",
    "_meta": {
      "title": "Apply ControlNet"
    },
    "inputs": {
      "positive": [
        "3",
        0
      ],
      "negative": [
        "4",
        0
      ],
      "control_net": [
        "5",
        0
      ],
      "image": [
        "1",
        0
      ],
      "strength": 0.6,
      "start_percent": 0.0,
      "end_percent": 1.0
    }
  },
  "7": {
    "class_type": "EmptyLatentImage",
    "_meta": {
      "title": "Empty Latent"
    },
    "inputs": {
